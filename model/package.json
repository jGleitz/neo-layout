{
  "name": "neo-layout-model",
  "version": "0.1.0",
  "description": "Neo2 keyboard layout model and A-REFERENZ-A converter",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "schema:types": "json2ts --unreachableDefinitions --input layout.schema.yaml --output src/generated/layout.ts",
    "compile": "tsc",
    "build": "pnpm schema:types && pnpm compile",
    "format": "prettier --write .",
    "generate": "node dist/convert.js"
  },
  "devDependencies": {
    "@tsconfig/node26": "catalog:",
    "@types/node": "catalog:",
    "@types/unicode-name": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "unicode-name": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "yaml": "catalog:"
  }
}
