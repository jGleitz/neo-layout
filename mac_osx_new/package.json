{
  "name": "neo-layout-mac-osx-new",
  "version": "0.1.0",
  "description": "Neo keyboard layout generator for macOS",
  "type": "module",
  "scripts": {
    "compile": "tsc",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "generate": "node dist/generate.js",
    "build": "pnpm compile && pnpm generate",
    "validator:build": "cargo build --manifest-path keylayout-validator/Cargo.toml --release",
    "validator:run": "./keylayout-validator/target/release/keylayout-validator --strict neo-layouts-v3.bundle/Contents/Resources/",
    "validate": "pnpm validator:build && pnpm validator:run",
    "install-bundle": "rm -rf \"$HOME/Library/Keyboard Layouts/neo-layouts-v3.bundle\" && cp -R neo-layouts-v3.bundle \"$HOME/Library/Keyboard Layouts/\""
  },
  "dependencies": {
    "fast-xml-builder": "catalog:",
    "neo-layout-model": "workspace:*",
    "xmlbuilder2": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node26": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
